# === App ===
APP_NAME=accent-trainer
APP_ENV=development # development | production | test
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# === Auth ===
AUTH_SECRET=change-me-to-a-long-random-string-please
AUTH_JWT_LIFETIME_SECONDS=3600

# === API ===
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === ASR ===
ASR_WHISPER_MODEL=base
ASR_WHISPER_DEVICE=cpu
ASR_WHISPER_COMPUTE_TYPE=int8
ASR_LANGUAGE=en
ASR_MODELS_DIR=data/asr_models

# === Audio processing ===
AUDIO_TARGET_SR=16000
AUDIO_LPC_ORDER=12
AUDIO_FORMANT_MIN_HZ=90
AUDIO_FORMANT_MAX_HZ=5500
AUDIO_FFMPEG_BINARY=ffmpeg

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=accent
POSTGRES_PASSWORD=accent_dev_pw
POSTGRES_DB=accent_trainer

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === MinIO ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_pw
MINIO_SECURE=false
MINIO_BUCKET_USER_RECORDINGS=user-recordings
MINIO_BUCKET_REFERENCE_AUDIO=reference-audio
MINIO_BUCKET_SPECTROGRAMS=spectrograms

# === TTS ===
TTS_PIPER_BINARY=piper
TTS_VOICES_DIR=data/piper_voices
TTS_DEFAULT_VOICE=en_US-lessac-medium
TTS_SAMPLE_RATE=22050